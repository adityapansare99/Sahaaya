# Server
PORT=8001

# ── Vector store ──────────────────────────────────────────────
# "chroma" (production) or "json" (local file cache).
# Auto: "chroma" if CHROMA_URL OR CHROMA_API_KEY is set, otherwise "json".
# VECTOR_STORE=chroma

# ── Option 1: Chroma Cloud (managed — RECOMMENDED for production) ──
# Connect by URL+key like MongoDB Atlas. No Docker, no extra service to run.
# Get these three from your Chroma Cloud dashboard: https://trychroma.com
# (create a Cluster → note the Tenant, Database, and API key).
# CHROMA_API_KEY=
# CHROMA_TENANT=
# CHROMA_DATABASE=

# ── Option 2: self-hosted Chroma server (local dev / private deployment) ──
# A Chroma HTTP server URL, e.g. a local Docker container or a separate host.
# Leave unset to use the zero-setup JSON store for local dev.
# CHROMA_URL=http://localhost:8000
# Optional bearer token — set if your Chroma server has token auth enabled
# (recommended when the Chroma URL is public).
# CHROMA_AUTH_TOKEN=

# Shared by both Chroma modes:
# CHROMA_COLLECTION=sahaaya_kb

# Pin the @xenova/transformers model cache (~30MB) to a persistent path so cold
# boots don't re-download the embedding model. On Render, point this at a disk.
# TRANSFORMERS_CACHE=/opt/render/.cache/transformers

# ── LLM provider ──────────────────────────────────────────────
# "groq" (production) or "ollama" (local). Auto: "groq" if GROQ_API_KEY is set.
# LLM_ENABLED=true
# LLM_PROVIDER=groq

# Groq — get a key at https://console.groq.com (API Keys). OpenAI-compatible.
# GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_MAX_TOKENS=1024

# Ollama — local-dev fallback (run `ollama pull mistral`).
# OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=mistral

# ── Integration / security ────────────────────────────────────
# Main Sahaaya backend healthcheck URL (used for "live platform context").
MAIN_BACKEND_URL=http://localhost:8000

# Comma-separated allowed frontend origins. Empty = allow all (dev only).
# CORS_ORIGIN=https://your-frontend.vercel.app,https://your-admin.vercel.app

# Chat requests allowed per minute per IP.
# CHAT_RATE_LIMIT=30
