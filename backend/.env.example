# Server
PORT=8000
NODE_ENV=development

# MongoDB Atlas connection string (MUST end with "/")
dblink=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/

# Auth / JWT
refreshtoken=change-this-jwt-secret
refreshtime=10d

# Admin login (separate admin JWT)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this
ADMIN_JWT_SECRET=change-this-admin-jwt-secret

# Socket.IO allowed origin (your frontend URL)
FRONTEND_URL=http://localhost:5173

# Cloudinary (file uploads)
cloud_name=
api_key=
api_secret=

# Email / SMTP (password reset, notifications)
email_host=smtp.gmail.com
email_port=587
email_user=
email_pass=
email_from=

# Server-side Google Maps key (only used by the partner-geocode backfill script)
GOOGLE_MAPS_API_KEY=
